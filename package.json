{
  "name": "factify-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "backend": "cd backend && uvicorn factify_search:app --port 8000",
    "backend:test": "cd backend && python -m pytest -q",
    "dev:all": "concurrently \"npm run dev\" \"npm run backend\"",
    "verify": "tsc --noEmit && eslint && npm run check:secrets && vitest run && next build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-progress": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
